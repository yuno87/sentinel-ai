# Copy this file to .env and fill in your key.
# The key is only read by the Python server. It is never sent to the browser.
ANTHROPIC_API_KEY=

# Claude model used for every step (analysis, attacks, prediction, judging, hardening).
SENTINEL_MODEL=claude-opus-5-5

# Set to 1 to run without an API key, using pre-written responses for the built-in example.
SENTINEL_DEMO=0
