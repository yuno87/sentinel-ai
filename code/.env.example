# Optional. Without a key, Sentinel runs in demo mode: pre-written answers for
# the built-in example bot, no AI calls, nothing to pay for.
#
# To use a real AI, copy this file to .env (in this code/ folder) and fill in
# ONE of the keys below. Keys are only read by the Python server and are never
# sent to the browser. Never commit .env.

# Free: create one at https://aistudio.google.com/apikey (sign in with Google)
GEMINI_API_KEY=

# Paid alternative: https://console.anthropic.com (used instead of Gemini if set)
ANTHROPIC_API_KEY=

# Models (optional overrides)
SENTINEL_GEMINI_MODEL=gemini-3.5-flash-lite
SENTINEL_MODEL=claude-opus-5-5
