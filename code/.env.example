# Optional. Without a key, Sentinel runs in demo mode: pre-written answers for
# the built-in example bot, no AI calls, nothing to pay for.
#
# To use the real model later, copy this file to .env (in this code/ folder)
# and paste an Anthropic API key below. The key is only read by the Python
# server and is never sent to the browser. Never commit .env.
ANTHROPIC_API_KEY=

# Claude model used for every step when a key is set.
SENTINEL_MODEL=claude-opus-5-5
